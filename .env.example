# 阿里云API配置（同传实时模型）
ALIYUN_API_KEY=your_aliyun_api_key_here
ALIYUN_WORKSPACE_ID=your_workspace_id_here
ALIYUN_MODEL=qwen3.5-livetranslate-flash-realtime
ALIYUN_REGION=cn-beijing

# 文本生成API Key（用于AI会谈总结，调用qwen-turbo）
# 注意：业务空间API Key（sk-ws-xxx）可能无法调用文本生成模型
# 建议在百炼控制台创建一个通用的API Key（sk-xxx格式）填入此处
# 如果不设置，将默认使用ALIYUN_API_KEY
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 服务器端口
PORT=10000
